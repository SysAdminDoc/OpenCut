{
  "name": "opencut-panel",
  "version": "1.56.0",
  "private": true,
  "description": "OpenCut CEP Panel for Adobe Premiere Pro",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 \"client/*.js\" && npm run lint:premiere",
    "lint:premiere": "cd ../com.opencut.uxp && eslint --max-warnings 0 \"*.js\"",
    "typecheck:bolt": "tsc -p ../com.opencut.uxp/bolt-webview/tsconfig.json",
    "pretest": "npm run build && npm run build:verify",
    "test": "vitest run --config vitest.config.mjs",
    "pretest:rendered": "npm run build && npm run build:verify",
    "test:rendered": "playwright test --config playwright.config.mjs",
    "pretest:rendered:update": "npm run build && npm run build:verify",
    "test:rendered:update": "playwright test --config playwright.config.mjs --update-snapshots",
    "audit:check": "node scripts/check-advisories.mjs",
    "audit:check:win": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%INIT_CWD%\\scripts\\panel-node-gate.ps1\" audit:check",
    "audit:esbuild": "node scripts/check-esbuild-pin.mjs",
    "audit:esbuild:win": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%INIT_CWD%\\scripts\\panel-node-gate.ps1\" audit:esbuild",
    "build:verify": "node scripts/verify-build.mjs --require-build",
    "build:verify:win": "powershell -NoProfile -ExecutionPolicy Bypass -File \"%INIT_CWD%\\scripts\\panel-node-gate.ps1\" build:verify"
  },
  "devDependencies": {
    "@adobe/eslint-plugin-premierepro": "27.0.0",
    "@adobe/premierepro": "27.0.0",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "terser": "^5.47.1",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "brace-expansion": "5.0.12",
    "esbuild": "^0.25.0",
    "js-yaml": "^4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "source-map-js": "1.2.2"
  }
}
